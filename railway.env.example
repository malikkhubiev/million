# Скопируй в Variables сервиса Railway (или: railway variables --set KEY=value).
# Секреты сюда не коммить — только шаблон.

APP_ENV=production
APP_NAME=Верни себе себя
APP_BASE_URL=https://ВАШ-СЕРВИС.up.railway.app
CORS_ORIGINS=*
SECRET_KEY=сгенерируй-длинную-случайную-строку

# SQLite на Volume /app/data (см. RAILWAY.md). Для продакшена лучше Postgres.
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

SITE_URL=https://life-energy-phi.vercel.app
ENROLLMENT_DEADLINE=20 сентября
COURSE_START_DATE=1 октября

PRODUCT_PRICE_KOPECKS=5000000
PRODUCT_TITLE=Трансформация «Верни себе себя»
VIP_DIAG_PRICE_KOPECKS=1000000
VIP_TRAIN_PRICE_KOPECKS=19000000

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=teacher_life_bot
TELEGRAM_CHANNEL_ID=
TELEGRAM_INVITE_EXPIRE_DAYS=30
TELEGRAM_INVITE_MEMBER_LIMIT=1
TELEGRAM_MODE=webhook
TELEGRAM_WEBHOOK_SECRET=сгенерируй-секрет
TELEGRAM_WEBHOOK_PATH=/api/telegram/webhook

YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_CAPTURE=true
YOOKASSA_VAT_CODE=
YOOKASSA_TAX_SYSTEM_CODE=
YOOKASSA_WEBHOOK_PATH=/api/yookassa/webhook

METRIKA_COUNTER_ID=112323537
METRIKA_MP_TOKEN=
