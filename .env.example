# --- Приложение ---
APP_NAME=Верни себе себя
APP_ENV=development
APP_BASE_URL=http://127.0.0.1:8000
SECRET_KEY=смени-на-случайную-строку

# Цена в копейках (50000 ₽ = 5000000)
PRODUCT_PRICE_KOPECKS=5000000
PRODUCT_TITLE=Программа «Верни себе себя»

# --- База данных ---
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# --- ЮKassa (только сервер, никогда в фронтенд) ---
# Тест: демо-магазин в кабинете ЮKassa
# Доки: https://yookassa.ru/developers/api
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# true = одностадийная оплата (деньги сразу)
YOOKASSA_CAPTURE=true
# Опционально: VAT для чека 54-ФЗ (1=без НДС). Оставь пустым, чтобы не слать receipt
YOOKASSA_VAT_CODE=1
YOOKASSA_TAX_SYSTEM_CODE=1

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# ID закрытого канала, вида -100xxxxxxxxxx
# Как узнать: добавь бота админом, перешли пост канала боту @userinfobot
# или запусти: python -m app.scripts.discover_channel
TELEGRAM_CHANNEL_ID=
# Срок жизни пригласительной (дней). 0 = без срока
TELEGRAM_INVITE_EXPIRE_DAYS=30
# Лимит использований ссылки (обычно 1)
TELEGRAM_INVITE_MEMBER_LIMIT=1

# polling = локальная проверка бота; webhook = Render/прод
TELEGRAM_MODE=polling
# Для webhook на проде (должен совпадать с URL сервиса)
TELEGRAM_WEBHOOK_SECRET=смени-на-случайный-секрет
TELEGRAM_WEBHOOK_PATH=/api/telegram/webhook

# ЮKassa webhook path
YOOKASSA_WEBHOOK_PATH=/api/yookassa/webhook