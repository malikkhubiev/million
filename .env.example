# Бэкенд / бот
APP_ENV=development
APP_BASE_URL=http://127.0.0.1:8000
SECRET_KEY=смени-на-случайную-строку
CORS_ORIGINS=*

PRODUCT_PRICE_KOPECKS=5000000
PRODUCT_TITLE=Групповая Трансформация · 14 дней

# Ссылка на лендинг (кнопка в боте). Пусто — берётся APP_BASE_URL.
SITE_URL=
ENROLLMENT_DEADLINE=20 сентября
COURSE_START_DATE=1 октября

DATABASE_URL=sqlite+aiosqlite:///./data/app.db

VIP_DIAG_PRICE_KOPECKS=1000000
VIP_DIAG_TITLE=Персональная Трансформация · диагностический созвон, 60 мин
VIP_TRAIN_PRICE_KOPECKS=19000000
VIP_TRAIN_TITLE=Персональная Трансформация · 14 дней

# ЮKassa — тестовый магазин: ключ test_… и shop id кабинета
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_CAPTURE=true
# Чек 54-ФЗ: числа или пусто, если фискализация выключена
YOOKASSA_VAT_CODE=
YOOKASSA_TAX_SYSTEM_CODE=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=teacher_life_bot
TELEGRAM_CHANNEL_ID=
TELEGRAM_INVITE_EXPIRE_DAYS=30
TELEGRAM_INVITE_MEMBER_LIMIT=1
# Локально: polling. На Render обязательно webhook (+ APP_BASE_URL=https://….onrender.com).
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_SECRET=смени-на-случайный-секрет
TELEGRAM_WEBHOOK_PATH=/api/telegram/webhook
YOOKASSA_WEBHOOK_PATH=/api/yookassa/webhook

# Лендинг (Vercel)
SITE_URL=https://life-energy-phi.vercel.app

# Яндекс.Метрика Measurement Protocol
# Настройки счётчика → Безопасность → включить Measurement Protocol → токен
METRIKA_COUNTER_ID=112323537
METRIKA_MP_TOKEN=

